// ============================================================================
//  Oracle-text grammar — MTG Foundations set
//  Convention: UPPERCASE = terminals (raw tokens / regex), lowercase = rules.
//  No card names, numbers or colors are hardcoded into structural rules.
//  Targets / subjects / objects are decomposed into atomic components:
//    quantifier | otherness | status | color | card_kind | controller | zone
// ============================================================================

start: sentence+

// ----------------------------------------------------------------------------
//  sentence dispatch (deterministic by prefix)
// ----------------------------------------------------------------------------
sentence: loyalty_sentence
        | for_each_sentence
        | enchanted_sentence
        | keyword_static_sentence
        | modal_sentence
        | activated_sentence
        | as_long_sentence
        | as_cost_sentence
        | during_sentence
        | until_sentence
        | triggered_sentence
        | if_sentence
        | static_sentence
        | static_keyword_sentence
        | effect_sentence
        | deck_rule
        | round_up_sentence

// ----------------------------------------------------------------------------
//  conditional static ability:  "If <condition>, <effect>."
// ----------------------------------------------------------------------------
deck_rule: "A" "deck" "can" "have" ("any" "number" "of" | amount) "cards" "named" (THIS_CARD | CARDNAME)
round_up_sentence: "Round" "up" "each" "time"

if_sentence: V_IF any_text "," effect instead_suffix?
            | V_IF any_text "," any_text
            | V_IF any_text
instead_suffix: INSTEAD ("of" any_text)?

// ----------------------------------------------------------------------------
//  static restrictions / one-liners that aren't keyword lists
// ----------------------------------------------------------------------------
static_sentence: "Activate" "only" "as" "a" "sorcery"
               | "Activate" "only" "once" ("each" | "per") "turn"
               | "Activate" "only" "if" any_text
               | "Activate" "only" "once"
               | "Activate" "only" "during" "your" "turn"
               | "This" "ability" "triggers" "only" "once" ("each" | "per") "turn"
               | "This" "spell" "can't" "be" "countered"
               | "It's" "still" "a" GENERIC_TYPE
               | "This" "card" "is" "still" "a" GENERIC_TYPE
               | "You" "can't" "lose" "the" "game"
               | "Your" "opponents" "can't" "win" "the" "game"
               | "You" "can't" "lose" "the" "game" "and" "your" "opponents" "can't" "win" "the" "game"
               | "Players" "can't" "gain" "life"
               | "Each" "player" "loses" "the" "game"
               | "You" "win" "the" "game"
               | "You" "lose" "the" "game"
               | "It's" "a" CARDNAME "in" "addition" "to" "its" "other" "types"
               | "This" "creature" "is" "the" "chosen" "type" "in" "addition" "to" "its" "other" "types"
               | card_target "enter" "tapped" ("unless" any_text)?
               | card_target V_CAN "block" "only" card_target
               | card_target V_CAN "attack" "only" card_target
               | "It's" ("a" | "an") GENERIC_TYPE
               | V_YOU "control" card_target
               | card_target "loses" "all" "abilities" "and" "is" "a" colors? CARDNAME? GENERIC_TYPE "creature" "with" "base" "power" "and" "toughness" POWER_T ("named" CARDNAME)?

// ----------------------------------------------------------------------------
//  loyalty   [+1]: <effect>   [−4]: <effect>
// ----------------------------------------------------------------------------
loyalty_sentence: LOY_COST ":" effect (xdef_clause)?
LOY_COST: /\[[\-\u2212+]?(?:\d+|X)\]/

// ----------------------------------------------------------------------------
//  modal     "Choose one"  /  "Choose one that hasn't been chosen"
// ----------------------------------------------------------------------------
modal_sentence: "Choose one"
              | "Choose one that hasn't been chosen"
              | "Choose" WORD

// ----------------------------------------------------------------------------
//  activated ability
//    <cost>, <cost>, ... : <effect>
//    cost item: mana | {T} | {Q} | Sacrifice <card> | Remove <counter> |
//                Tap <card> | Exile <card> | Pay <n> life
// ----------------------------------------------------------------------------
activated_sentence: cost_list ":" if_clause? effect xdef_clause?
cost_list: cost_item ("," cost_item)*
cost_item: MANA+
         | MANA+ "and" MANA+
         | "{T}"
         | "{Q}"
         | V_SACRIFICE card_target
         | V_REMOVE counter_amount "counter" "from" card_target
         | V_REMOVE "a" counter_name "counter" "from" card_target
         | V_REMOVE amount counter_name "counters" "from" card_target
         | V_TAP card_target
         | V_EXILE card_target
         | V_PAY amount "life"
         | V_PAY amount "mana"
         | V_PUT counter_amount counter_kind "on" card_target
         | V_RETURN card_target "to" "its" "owner's" "hand"

// ----------------------------------------------------------------------------
//  triggered ability
//    <trigger clause> [if <condition>], <effect>
// ----------------------------------------------------------------------------
triggered_sentence: trigger_clause "," if_clause? effect xdef_clause? trailing_if?
as_long_sentence: "As" "long" "as" any_text "," effect
during_sentence: "During" during_time "," effect
until_sentence: "Until" "end" "of" "turn" "," effect
              | "Until" "the" "end" "of" "your" "next" "turn" "," effect
as_cost_sentence: "As" "an" "additional" "cost" "to" "cast" "this" "spell" "," effect
during_time: "your" "turn" | "each" "of" "your" "turns" | "combat"
trigger_clause: trig_when event?
              | COND_KEYWORD EMDASH trig_when event?
              | COND_KEYWORD EMDASH event?
              | COND_KEYWORD EMDASH static_text
trig_when: V_WHEN | V_WHATEVER | V_AT "the" "beginning" "of" AT_WHEN | V_AS
AT_WHEN: /the end step|each end step of the game|your upkeep|your end step|each end step|each of your turns|combat on your turn|each combat|combat|your untap step|each player's draw step|your main phase|your first main phase|each player's main phase|each player's first main phase|each player's upkeep|your combat step|your first upkeep/
event: event_subject EVENT_VERB event_object?
      | V_YOU EVENT_VERB event_object?
      | V_YOU V_PUT counter_amount counter_kind "on" card_target
      | event_subject "is" "put" "into" zone
      | event_subject EVENT_VERB "while" any_text
      | V_YOU "attack" "with" ("one" "or" "more" | amount ("or" "more")?) "creatures"
      | V_YOU "do"
      | "there" "are" amount "or" "more" counter_name "counters" "on" card_target
      | ("one" "or" "more")? counter_amount counter_kind "are" "put" "on" card_target
      | V_YOU "cast" card_target "or" card_target "enters"
      | V_YOU "cast" "a" "spell" "during" any_text
      | ("one" "or" "more")? card_target "attack"
      | V_YOU "next" "cast" event_object ("this" "turn")?
      | V_YOU V_SACRIFICE card_target
      | V_THAT "mana" "is" "spent" "to" "cast" event_object
event_subject: card_target "or" card_target | card_target | player
EVENT_VERB: /enters or dies|enters or attacks|attacks for the first time each turn|is countered|is dealt|is put|enters|dies|attacks|attack|deals|becomes|casts|cast|discards|draws|draw|gains|gain|loses|lose|taps|untaps|blocks|block|fights|leaves|resolves/
event_object: ("combat" "damage" "to" (player | card_target))?
            | ("combat" | "noncombat") "damage" "to" (player | card_target)
            | ("combat" | "noncombat") "damage" "during" "your" "turn"
            | "your" "second" "card" "each" "turn"
            | "the" "target" "of" "a" "spell" "or" "ability"
            | ("you" | player) "or" ("a" | "an")? "planeswalker" "you" "control"
            | "a" "card"
            | "a" "spell" "that" "targets" card_target
            | "a" "spell"
            | "a" "noncreature" "spell"
            | "a" colors "instant" "or" "sorcery" "spell"
            | "an" "instant" "or" "sorcery" "spell"
            | "a" "noncreature" "or" CARDNAME "spell"
            | "an" "instant" "or" "sorcery"
            | "a" "sorcery" "spell"
            | "a" "land"
            | "life" "for" "the" "first" "time" ("each" "turn" | "during" "each" "of" "your" "turns")
            | "life"
            | "damage" "to" (player | card_target)
            | "the" "battlefield"
            | card_target
if_clause: V_IF any_text ","
trailing_if: V_IF any_text

// ----------------------------------------------------------------------------
//  static keyword list (optionally with a modifier: Ward {4}, Kicker {2}, ...)
// ----------------------------------------------------------------------------
static_keyword_sentence: kw_with_mod
                       | kw_list
                       | kw_list_mod
                       | kw_list "," kw_with_mod
                       | kw_with_mod "," kw_list
                       | generic_kw_list
generic_kw_list: generic_kw (kw_sep generic_kw)*
generic_kw: CARDNAME (MANA+ | number | EMDASH effect)?
kw_list_mod: kw_item ("," kw_item)* ("," "and" kw_item)?
kw_item: KEYWORD (MANA+ | "from" colors)?
       | "protection" "from" CARDNAME (("and" | "," | "," "and") "from" CARDNAME)*
kw_with_mod: MOD_KEYWORD (MANA+ | "for" card_target | "from" (colors | "instants" | "sorceries" | GENERIC_TYPE) | number)?
            | MOD_KEYWORD EMDASH V_PAY amount "life"
            | MOD_KEYWORD EMDASH MANA+ ("," V_PAY amount "life")?
            | "Protection" "from" (colors | "everything")
            | "Hexproof" "from" (colors | "instants")

// ----------------------------------------------------------------------------
//  generic effect sentence
// ----------------------------------------------------------------------------
effect_sentence: ("Then" | "And" | "Otherwise" ",")? effect (xdef_clause)? trailing_if?
              | ("Then" | "And") if_sentence

// ----------------------------------------------------------------------------
//  effect = one or more actions joined by and / then / ,
// ----------------------------------------------------------------------------
effect: (effect_timing)? action (JOIN action)*
effect_timing: "Until" "end" "of" "turn" ","
             | "Until" ("your" | "their") "next" ("end" "step" | "turn") ","
             | "At" "the" "beginning" "of" ("your" | "the" | "their") "next" "end" "step" ","
             | "At" "the" "beginning" "of" (OWNER)? "next" "end" "step" ","
              | ("During" | "Until") OWNER? "next" "turn" ","
              | "Until" "the" "end" "of" "your" "next" "turn" ","
JOIN: /,\s*(then|and)\b|\bthen\b|\band\b|,/

// ----------------------------------------------------------------------------
//  actions — each built from atomic pieces (card_target, amount, zone, ...)
// ----------------------------------------------------------------------------
action: add_mana_action
       | create_token_action
       | put_counter_action
       | remove_counter_action
       | search_action
       | draw_action
       | gain_life_action
       | lose_life_action | lose_kw_action
       | gain_poison_action
       | deal_damage_action
       | counter_spell_action
       | return_action
       | put_zone_action
       | put_library_action
       | exile_action
       | destroy_action
       | tap_action
       | untap_action
       | no_untap_action
       | can_block_action
       | sacrifice_action
       | regenerate_action
       | gain_control_action
       | scry_action
       | surveil_action
       | mill_action
       | fight_action
       | suspect_action
       | attach_action
       | stat_action
       | base_pt_action
       | gain_kw_action
       | become_action
       | gain_quote_action
       | prevent_action
       | look_action
       | reveal_action
       | discard_action
       | shuffle_action
       | cast_action
       | play_action
       | reveal_top_action
       | enters_action
       | enchant_action
       | cant_action
       | no_max_hand_action
       | can_gain_life_action
       | attacks_each_combat_action
       | block_do_so_action
       | choose_action
       | may_action
       | cost_mod_action
       | double_action
       | separate_action
       | spend_mana_action
       | pay_action
       | end_turn_action
       | distribute_action
       | copy_action
       | trigger_extra_action
       | lose_game_action
       | count_action
       | have_deal_action
       | choose_new_targets_action
       | change_target_action
       | stat_define_action
       | emblem_action
       | phase_action
       | extra_turns_action

phase_action: card_target V_PHASE ("in" | "out")
extra_turns_action: (who)? V_TAKE ("a" | "an" | amount) "extra" ("turn" | "turns") ("after" "this" ("one" | "turn"))?

// ---- individual actions ----

add_mana_action: V_ADD mana_amount
mana_amount: "one" "mana" "of" "any" "color" | amount MANA
           | amount "mana" "of" "any" "one" "color"
           | amount "mana" "in" "any" "combination" "of" "colors"
           | "one" "mana" "of" "the" "chosen" "color"
           | "three" "mana" "of" "any" "one" "color"
           | "two" "mana" "of" "any" "one" "color"
           | "G" "for" "each" card_target
           | MANA+ ("or" MANA+)*
           | MANA+ "for" "each" card_target

create_token_action: (who)? V_CREATE token ("if" any_text)? ("for" "each" card_target ("that" "died" "this" "turn")?)?
token: "a" "token" "that's" "a" "copy" "of" card_target token_except?
      | token_num ("tapped")? POWER_T? tok_colors? token_types? ("artifact")? ("creature" | "card")? "token" "s"? token_tail*
      | token_proper "," "a" "legendary" POWER_T? tok_colors? token_types? "creature" "token"
      | "a" "number" "of" POWER_T? tok_colors? token_types? "creature" "tokens" "equal" "to" xdef ("named" ("~" | CARDNAME))?
tok_colors: (COLOR | "colorless" | "multicolored") (("," | "and" | "or") (COLOR | "colorless" | "multicolored"))*
token_tail: ("named" ("~'s" CARDNAME | CARDNAME))
           | ("with" (kw_list | QUOTE))
           | ("that" "are" "tapped" ("and" "attacking")?)
           | ("that's" "tapped" ("and" "attacking")?)
           | ("and" QUOTE)
           | ("for" "each" card_target)
           | ("where" "X" "is" xdef)
           | in_zone
token_proper: CARDNAME token_proper_tail*
token_proper_tail: "of" "the" CARDNAME | "of" CARDNAME | "and" CARDNAME
token_num: "a" | "an" | "that" "many" | amount
token_types: CARDNAME+
token_except: (",")? "except" "it" "has" kw_list ("and" QUOTE)?
             | (",")? "except" "it's" (V_A | V_AN)? CARDNAME "in" "addition" "to" "its" "other" "types"

put_counter_action: V_PUT counter_amount counter_kind "on" card_target ("and" counter_amount counter_kind "on" card_target)? ("for" "each" "of" card_target "'s" "colors")?
remove_counter_action: V_REMOVE counter_amount counter_kind "from" card_target
             | (who)? V_LOSE "all" counter_kind
counter_kind: (POWER_MOD | counter_name)? "counter" "s"?
counter_amount: amount | "one" "or" "more" | "that" "many" | "a" | "an"
counter_name: WORD+

search_action: V_SEARCH zones "for" card_target ("named" (THIS_CARD | CARDNAME) (("and" | "or" | "and/or") card_target)*)? ("with" "the" "same" "name" ("as" (THIS_CARD | CARDNAME))?)? ("reveal" "it")? ("and"? "put" ("it" | "them") "into" zone)? ("then" "shuffle" ("and" "put" "that" "card" "on" "top")?)?
             | V_SEARCH zone "for" card_target ("named" (THIS_CARD | CARDNAME))? ("put" ("it" | "them") "onto" "the" "battlefield" "tapped"?)? ("then" "shuffle")?
             | V_SEARCH zone "for" card_target ("exile" "it")? ("then" "shuffle")?
             | V_SEARCH zones "for" card_target "with" "that" "name" "and" "exile" ("them" | "it")
             | V_SEARCH zone "for" card_target (",")? ("put" ("it" | "that" "card") ("into" zone | "onto" "the" "battlefield" "tapped"?))? ("then" "shuffle" ("and" "put" "that" "card" "on" "top")?)?
             | V_SEARCH zone "for" card_target ","? V_PUT ("it" | "them") "onto" "the" "battlefield" "tapped"? ","? "then" "shuffle"

draw_action: (who)? V_DRAW draw_amount "card" "s"? "for" "each" card_target
            | ("Any" | "any") "number" "of" "target" "players" "each" V_DRAW draw_amount "card" "s"?
            | (who)? V_DRAW draw_amount "card" "s"? ("for" "each" "different" "mana" "value" "among" card_target)?
           | (who)? V_DRAW draw_amount "card" "s"?
           | (who)? V_DRAW "cards" "equal" "to" ("its" "power" | "half" "the" "number" "of" "cards" "in" zone | xdef)
draw_amount: amount | "a" | "an" | "an" "additional" | "that" "many" | "that" "much"

gain_life_action: who V_GAIN life_amount ("for" "each" card_target ("that" "died" "this" "turn")?)?
             | who V_GAIN "life" "equal" "to" any_text
                | who V_GAIN "life" "equal" "to" xdef
life_amount: amount "life" | "twice" "that" "much" "life" | "double" "that" "much" "life" | "half" ("their" | "a" | "your" | "his" | "her" | "an" "'opponent'" "s") "life"
           | "that" "much" "life" ("plus" amount)? | "that" "many" "life"
           | "life" "equal" "to" "the" "life" "lost" "this" "way"
dmg_amount: amount | "that" "much" | "double" "that" | "double" "that" "much"
           | "triple" "that" | "triple" "that" "much"
           | "that" "much" "plus" amount | "double" "that" "plus" amount | "double" "that" "much" "plus" amount
lose_life_action: who V_LOSE life_amount ("unless" any_text)?
                | player V_LOSE life_amount ("unless" any_text)?
                | player "who" V_CANT V_LOSE life_amount
                | who V_LOSE "life" "equal" "to" xdef
                | who V_LOSE "life" "equal" "to" ("its" | "their") ("mana" "value" | "power" | "toughness")
                | player V_LOSE "life" "equal" "to" xdef
lose_kw_action: lead? card_kind V_LOSE (kw_list | "all" "abilities" | "all" "keyword" "abilities") ("until" "end" "of" "turn")?
gain_poison_action: who V_GET amount "poison" "counters"

deal_damage_action: card_target V_DEAL dmg_amount? "damage" "to" damage_who ("and" "you" V_GAIN amount "life")? ("and" dmg_amount "damage" "to" "that" "creature's" "controller")?
                   | card_target V_DEAL "damage" "equal" "to" any_text "to" damage_who
                  | ("it" | "they") V_DEAL dmg_amount? "damage" "to" damage_who
                  | ("it" | "they") V_DEAL dmg_amount "damage"
                  | card_target V_DEAL dmg_amount? "damage" "to" damage_who ("and" dmg_amount? "damage" "to" damage_who)?
                  | ("it" | "they" | card_target) V_DEAL dmg_amount "damage" "plus" amount "to" damage_who
                  | dmg_amount? "damage" "to" damage_who
                  | card_target V_DEAL amount? "damage" "equal" "to" "its" "power" "to" damage_who
                  | card_target V_DEAL "damage" "to" damage_who "equal" "to" xdef
                  | card_target V_DEAL amount "damage" "divided" "as" "you" "choose" "among" "any" "number" "of" damage_who
                  | card_target V_DEAL dmg_amount "damage" "divided" divided_rest
damage_who: card_target "or" card_target
          | card_target "and/or" card_target
          | card_target
          | "itself"
          | "you"
          | "any" V_TARGET
          | "each" "of" "up to" amount "other" "target" "s"?
          | "each" "opponent"
          | "each" "player"
          | "each" "creature" "without" "flying"
          | "each" "creature" "and" "each" "player"
          | "each" "opponent" "and" "each" "planeswalker" "they" "control"
          | "each" "player" "and" "each" "creature"
divided_rest: (ANYWORD | ",")+

counter_spell_action: V_COUNTER card_target ("spell" | "ability")? ("with" any_text)? ("unless" any_text)?

return_action: V_RETURN card_target "to" (("its" | "their") "owner's" "hand" | "the" "battlefield" | "your" "hand" | ("its" | "their") "owners'" "hands")
             | V_RETURN card_target "to" "the" "battlefield" ("with" (amount "fewer" | "no") counter_kind "on" "it")? ("at" "the" "beginning" "of" "the" "next" "end" "step")?
             | V_RETURN card_target "to" "the" "battlefield" ("tapped" | "transformed")?
             | V_RETURN card_target "to" "the" "battlefield" ("tapped" "and" "transformed" | "transformed" "and" "tapped" | "tapped" | "transformed")? "under" ("its" "owner's" | "your") "control" ("with" counter_amount counter_kind "on" "it")? ("at" "the" "beginning" "of" "the" "next" "end" "step")?
             | V_RETURN card_target "with" "mana" "value" mv_cmp ("from" "your" "graveyard")? "to" "the" "battlefield"
mv_cmp: amount "or" ("less" | "more")
       | ("less" | "greater") "than" "or" "equal" "to" (card_target | V_THIS | V_THAT) "'s" ("power" | "mana" "value")
             | V_RETURN card_target "to" "its" "owner's" "hand" "tapped"
             | V_RETURN card_target "to" "its" "owner's" "hand" "and" "you" V_CREATE "a" "Treasure" "token"

// "X's owner puts it on their choice of the top or bottom of their library"
put_library_action: owner_subject V_PUT ("it" | card_target) "on" put_library_dest
                  | owner_subject V_PUT ("it" | card_target) "into" ("their" "hand" | "their" "graveyard")
put_library_dest: "their" "choice" "of" "the" "top" "or" "bottom" "of" "their" "library"
                | "the" ("top" | "bottom") "of" "their" "library"
owner_subject: card_target "'s" ("owner" | "owners'")
put_zone_action: (who)? V_PUT card_target "into" zone (("second" | "third") "from" "the" "top")? order_mod?
               | (who)? V_PUT card_target "on" "the" "bottom" ("of" zone)? order_mod?
               | V_PUT "the" "rest" "on" "the" "bottom" ("of" "your" "library")? order_mod?
               | "the" "rest" "on" "the" "bottom" ("of" "your" "library")? order_mod?
               | V_PUT "the" "rest" "into" zone
               | V_PUT card_target "into" zone "and" "the" "rest" "into" zone
               | V_PUT card_target "into" zone "and" "the" "other" "into" zone
               | (who)? V_PUT card_target "onto" "the" "battlefield" ("tapped" | "under" "your" "control")?
               | V_PUT card_target "on" "top" "of" zone
               | V_PUT "that" "pile" "into" "your" "hand" "and" "the" "other" "into" "your" "graveyard"
                | V_PUT ("them" | "it") "back" "in" "any" "order"
               | V_PUT "the" "exiled" "card" "into" zone
               | V_PUT "one" "of" "those" "cards" "back" "on" "top" "of" "your" "library"

order_mod: "in" ("a" "random" | "any") "order"

exile_action: V_EXILE card_target ("from" zone)? ("until" any_text)?
            | V_EXILE "the" "top" amount "cards" "of" "your" "library"
            | V_EXILE "the" "top" "card" "of" "your" "library"
            | V_EXILE "the" "top" "card" "of" "each" "player's" "library"
            | V_EXILE card_target "from" zone ("with" "a" counter_name "counter" "on" "it")?
            | V_EXILE "all" "other" card_target "tokens" "you" "control"
            | V_EXILE player "'s" "graveyard"
            | V_EXILE card_target "or" card_kind "that's" colors
            | V_EXILE card_target "that's" ("one" "or" "more")? "colors"
            | V_EXILE card_target "attached" "to" card_target
            | V_EXILE "all" "but" "the" "bottom" "card" "of" zone

destroy_action: V_DESTROY card_target ("attached" "to" card_target)? ("at" "random")?
              | V_DESTROY card_target "and" "all" "other" "permanents" "with" "the" "same" "name" "as" "that" "permanent"

tap_action: V_TAP card_target
untap_action: V_UNTAP card_target
no_untap_action: card_target "doesn't" "untap" "during" "its" "controller's" "next"? "untap" "step" ("for" "as" "long" "as" any_text)? (","? "and" "its" "activated" "abilities" "can't" "be" "activated")?
can_block_action: card_target "can" "block" ("any" "number" "of" | "up" "to" amount)? card_target
sacrifice_action: (who)? V_SACRIFICE card_target ("of" "their" "choice")? ("at" "the" "beginning" "of" ("the" | "your") "next" "end" "step")? ("at" "end" "of" "combat")? ("unless" any_text)?
regenerate_action: (who)? V_REGENERATE card_target
              | ("any" "opponent" | who) V_MAY V_SACRIFICE card_target ("of" "their" "choice")?
gain_control_action: (who)? V_GAIN "control" "of" card_target ("until" "end" "of" "turn")?
scry_action: ("each" "player" | who)? V_SCRY amount
surveil_action: V_SURVEIL amount
mill_action: (who)? V_MILL (("a" | "an" | amount | "that" "many") ("card" | "cards") | "half" ("their" | "his" | "her" | "a" | "the") "library" (","? "rounded" "down")?)
           | player V_MILL amount "cards"
suspect_action: ("Otherwise" ",")? V_SUSPECT card_target
fight_action: ("you" V_MAY)? "have" "it" V_FIGHT V_TARGET card_target ("you" "don't" "control")?
            | card_target V_FIGHT "each" "other"
            | ("Then" | "then")? card_target V_FIGHT card_target
            | ("it" | card_target)? V_FIGHT ("up to" "one")? V_TARGET card_target ("you" "don't" "control")?
            | "it" V_FIGHT V_TARGET card_target ("you" "don't" "control")?
attach_action: V_ATTACH card_target "to" (card_target | "the" "token") ("you" "control")?

stat_action: card_target (V_GET | V_GAIN) stat_change ("for" "each" (card_target | any_text))? ("until" "end" "of" "turn")? ("for" "each" (card_target | any_text))? ("as" "long" "as" any_text)?
           | ("you")? "have" card_target V_GET stat_change ("until" "end" "of" "turn")?
stat_change: ("an" | "a")? ("additional" | "another")? POWER_MOD ("and" ("has" | "gains" | "have" | "gain" | "loses" | "lose") kw_list)?
           | ("has" | "gains" | "have" | "gain") kw_list
gain_kw_action: card_target ("has" | "have" | "gains" | "gain") kw_list ("until" "end" "of" "turn")? ("as" "long" "as" any_text)?
base_pt_action: card_target ("has" | "gains" "gets") "base" "power" "and" "toughness" POWER_T ("until" "end" "of" "turn")?
pt_color_mod: colors (POWER_T)? | POWER_T colors?

become_action: card_target (V_IS | "are" | "become" | "becomes") (V_A | V_AN)? pt_color_mod? (CARDNAME+ (GENERIC_TYPE)? | types) become_tail?
             | card_target (V_IS | "are" | "become" | "becomes") (V_A | V_AN)? GENERIC_TYPE GENERIC_TYPE become_tail?
// NOTE: this rule used to end with three optional groups containing `any_text`
// ("with any_text", "that's any_text", "for as long as any_text"). `any_text` is
// ANYWORD+, i.e. unbounded, and the rule starts with a nullable card_target, so the
// chart for even "Draw a card" had to explore it. Measured: that single rule cost
// 93% of total parse time (6 sentences: 232s with it, 16.6s without). The tails are
// now closed phrases only; keep it that way and add a new closed alternative instead
// of reaching for any_text.
become_tail: "with" kw_list
           | "with" kw_list_mod
           | "in" "addition" "to" ("its" | "their") "other" ("colors" "and" "types" | "land" "types" | "types")
           | "with" "base" "power" "and" "toughness" POWER_T
           | "until" "end" "of" "turn"
           | "until" "your" "next" "turn"
           | "for" "as" "long" "as" "you" "control" "it"
prevent_action: V_PREVENT "all" ("combat" | "noncombat")? "damage" ("that" "would" "be")? "dealt" ("to" ("you" | "him" | "her" | "them" | card_target) (("and" | "or") ("you" | "him" | "her" | "them" | card_target))*)? ("this" "turn")?
              | V_PREVENT "all" ("combat" | "noncombat") "damage" "that" "would" "be" "dealt" "to" "and" "dealt" "by" card_target
              | V_PREVENT "all" ("combat" | "noncombat")? "damage" ("that" "would" "be")? "dealt" "this" "turn" "to" ("you" | "him" | "her" | "them" | card_target)
              | ("The")? "damage" V_CANT "be" "prevented"
              | V_PREVENT (amount "of" "that" | "that") "damage"
              | V_PREVENT "all" ("combat" | "noncombat")? "damage" "that" "would" "be" "dealt" "by" card_target ("this" "turn")?

look_action: V_LOOK "at" "the" "top" amount? "card" "s"? "of" "your" "library" ("any" "time")?
           | V_LOOK "at" "an" "opponent's" "hand"
reveal_action: V_REVEAL card_target ("at" "random")? ("from" "among" "them" | "from" "the" "top" "of" "your" "library" | "from" "the" "top" amount "cards" "of" "your" "library" | "from" ("their" | "your") "hand")? ("until" "you" V_REVEAL "a" card_kind)? ("and" V_PUT "it" ("into" "your" "hand" | "onto" "the" "battlefield" | "into" zone))?
             | V_REVEAL "the" "top" amount "cards" "of" "your" "library"
            | V_REVEAL "the" "top" "card" "of" "your" "library"
             | card_target V_REVEAL "their" "hand"
             | V_REVEAL card_target "from" "the" "top" "of" "your" "library" "until" "you" V_REVEAL "a" "land" "card"
            | V_REVEAL ("your" | "a" "player's") "hand"
discard_action: (who)? V_DISCARD card_target ("at" "random")? ("unless" any_text)?
              | (who)? V_DISCARD ("your" | "their") "hand"
              | "You" V_MAY V_DISCARD card_target ("unless" any_text)?
              | (who)? V_DISCARD "half" "the" "cards" "in" zone
shuffle_action: (who)? V_SHUFFLE ("your" "graveyard" "into" "your" "library")?
             | (who)? V_SHUFFLE card_target ("and" card_target)? "into" zone
             | (who)? V_SHUFFLE ("your" | "their") "hand" "and" "graveyard" "into" ("your" | "their") "library" | (who)? V_SHUFFLE card_target "and" "your" "graveyard" "into" zone
cast_action: V_CAST card_target ("from" ("your" "graveyard" | "the" "top" "of" "your" "library" | "among" card_target))? ("without" "paying" ("their" "mana" "costs" | "its" "mana" "cost"))? ("by" "removing" amount "counters" "from" "among" card_target)? ("in" "addition" "to" "paying" "its" "other" "costs")? ("this" "turn")? ("as" "though" ("they" | "it") "had" KEYWORD)?
play_action: V_PLAY ("an" "additional" "land" | card_target) ("exiled" "this" "way")? ("without" "paying" "its" "mana" "cost")? ("this" "turn")? ("on" "each" "of" "your" "turns")?
           | V_PLAY ("an" "additional" "land" | card_target) "until" "the" "end" "of" "your" "next" "turn"
reveal_top_action: "Play" "with" "the" "top" "card" "of" "your" "library" "revealed"
choose_action: (player)? V_CHOOSE amount? choose_obj
             | (V_YOU V_MAY)? V_CHOOSE choose_obj "from" card_target
copy_action: V_COPY (card_target "spell"? | "it" | V_THAT "spell" | V_THAT "ability") ("for" "each" any_text)?
trigger_extra_action: ("that" "ability" | "that" "triggered" "ability" | card_target) "triggers" ("an" "additional" | "another" | "additional") "time"
lose_game_action: (who | player | "you") (V_LOSE | V_WIN) "the" "game"
count_action: V_COUNT "the" "number" "of" card_target
have_deal_action: ("you" V_MAY)? "have" card_target V_DEAL dmg_amount? "damage" "to" damage_who
have_action: "have" card_target (V_LOSE life_amount | V_MILL "a" "card" | "enter" "as" "a" "copy" "of" ("any" card_target | card_target))
activate_action: V_ACTIVATE ("loyalty" | "activated" | "triggered")? "abilities" "of" card_target ("on" "any" "player's" "turn")? ("any" "time" "you" "could" "cast" "an" "instant")?
choose_new_targets_action: (V_YOU V_MAY)? V_CHOOSE "new" "targets" "for" any_text
choose_obj: "a" "color" "or" "none" | "a" "creature" "type" | "a" "color" | "one"
           | "any" "card" "name" | "a" "card" "name" | "an" "opponent's" "hand" | card_target | any_text | "a" any_text ("," any_text)* ("card" | "cards") "from" ("it" | zone)

may_action: (V_YOU | "that" "player" | "each" "player" | "an" "opponent" | controller_subject | owner_subject)? V_MAY (draw_action | discard_action | sacrifice_action | tap_action | untap_action
        | gain_life_action | lose_life_action | exile_action | attach_action | cast_action
        | play_action | scry_action | surveil_action | create_token_action | shuffle_action | reveal_action
        | search_action | look_action | counter_spell_action | return_action | put_zone_action | destroy_action | pay_action
        | put_counter_action | remove_counter_action | gain_control_action | deal_damage_action
        | stat_action | become_action | count_action | have_deal_action | have_action | distribute_action | activate_action
        | (V_TAP "or" V_UNTAP | V_UNTAP "or" V_TAP) card_target)

cost_mod_action: cost_subject V_COST cost_amount ("less" | "more") "to" ("cast" | "activate") cost_qual*
               | "The" WORD "cost" "is" "equal" "to" any_text
               | card_target V_COST "an" "additional" MANA+ "to" "cast"
cost_subject: card_target
            | ("activated" | "other" | "mana")? "abilities" "of" card_target
cost_qual: ("for" "each" any_text) | ("that" "target" any_text) | ("unless" any_text)
cost_amount: amount | MANA+
               | card_target "costs" "double" "what" "they" "normally" "would"
               | card_target "cost" "the" "same" "amount" "as" "its" "base" "mana" "cost"

double_action: V_DOUBLE "the" "number" "of" any_text
             | V_DOUBLE card_target "'s" "power" ("until" "end" "of" "turn")?
distribute_action: V_DISTRIBUTE any_text
separate_action: V_SEPARATE "them" "into" "a" "face-down" "pile" "and" "a" "face-up" "pile"
spend_mana_action: (V_YOU "can")? V_SPEND ("this" "mana" | "mana" "of" "any" "type") ("only")? "to" "cast" card_target
                  | "mana" "of" "any" "type" "can" "be" "spent" "to" "cast" card_target
pay_action: V_PAY MANA+ ("rather" "than" "pay" ("this" "spell's" | "its") "mana" "cost")?
           | V_PAY amount "life"
end_turn_action: "End" "the" "turn"
for_each_sentence: "For" "each" card_target "," effect
enchanted_sentence: "Enchanted" card_kind effect
keyword_static_sentence: COND_KEYWORD EMDASH effect ("as" "long" "as" any_text | trailing_if)?
stat_define_action: "~'s" "power" "and" "toughness" "are" "each" "equal" "to" xdef
                   | "~'s" "power" "is" "equal" "to" xdef
change_target_action: "Change" "the" "target" "of" any_text
gain_quote_action: (card_target)? (V_GAIN | "has" | "have") QUOTE

emblem_action: (V_YOU | player)? V_GET "an" "emblem" ("with" (QUOTE | any_text))?

enters_action: card_target V_ENTERS ("the" "battlefield")? ("tapped" | "prepared" | "with" counter_amount counter_kind "on" "it" | "with" ("an" | "a")? ("additional" | "another")? POWER_MOD "counter" "s"? "on" "it")? ("for" "each" any_text)? ("if" any_text)? ("unless" any_text)?
enchant_action: V_ENCHANT enchant_target
enchant_target: STATUS* GENERIC_TYPE (("," | "or" | "," "or") GENERIC_TYPE)*
cant_action: (card_target)? V_CANT ("have" counter_kind "put" "on" card_target | "get" counter_kind | "be" "countered" | "be" "regenerated" | "be" "activated" | "cast" ("spells" | "sorceries" | "instants" | "a" "spell") | "block" | "attack" | "attack" "or" "block" "alone"? | "be" "blocked" ("by" "more" "than" amount card_target | "by" card_target | "except" "by" card_target | "as" "long" "as" any_text)? | "attack" "unless" any_text | "block" "unless" any_text | "lose" "this" "mana" | "untap" "during" ("your" | "its" | "their" | "his" | "her") ("controller's")? "next"? "untap" "step" | "untap" "during" (V_THAT | "any" | "each") "player's" "next"? "untap" "step") ("this" "turn")? ("if" "able")? ("," "and" "its" "activated" "abilities" "can't" "be" "activated")?
no_max_hand_action: "You" "have" "no" "maximum" "hand" "size"
can_gain_life_action: "Players" V_CANT V_GAIN "life"
attacks_each_combat_action: card_target ("attacks" | "blocks") ("each" "combat" | "you" "this" "turn" | "this" "turn") "if" "able"
block_do_so_action: card_target "able" "to" "block" card_target "do" "so"

// permissive free text used only inside condition / keyword-trigger contexts
any_text: ANYWORD+
ANYWORD: /[a-zA-Z0-9+{}\/.\'~-]+/

// ----------------------------------------------------------------------------
//  X definition clause:  "where X is <something>"
// ----------------------------------------------------------------------------
xdef_clause: (",")? "where" "X" "is" xdef
xdef: "the" "number" "of" card_target | "the" "total" "power" "of" card_target | "the" "number" "of" any_text
    | "the" "total" "power" "of" card_target
    | "its" "power"
    | "its" "toughness"
    | "the" "mana" "value" "of" "that" "spell"
    | ("that" | "a" | "its") "creature's" "mana" "value"
    | "that" "card's" "mana" "cost"
    | "the" "amount" "of" "excess" "damage" "dealt" "to" "that" "creature" "this" "way"
    | "the" "greatest" "power" "among" "other" "creatures" "you" "control"
    | "this" "creature's" "power"
    | "~'s" "power"
    | "the" "sacrificed" "creature's" "toughness"
    | "your" "life" "total"
    | "the" "life" "lost" "this" "way"
    | "the" "amount" "of" "life" "you" "gained" "this" "turn"
    | "the" "number" "of" "cards" "in" "your" "opponents'" "graveyards"
    | "the" "number" "of" "attacking" "creatures"
    | CARDNAME "and" CARDNAME "'s" "power"
    | "the" "number" "of" "soul" "counters" "on" "this" "artifact"
    | "that" "creature's" "toughness"
    | "that" "permanent's" "mana" "value"

// ----------------------------------------------------------------------------
//  ATOMIC PIECES
// ----------------------------------------------------------------------------

//  amount: a count
amount: NUMBER | "X" | "one" | "two" | "three" | "four" | "five" | "six" | "seven" | "eight" | "nine" | "ten" | "eleven" | "twelve" | "thirteen" | "fourteen" | "fifteen" | "sixteen" | "seventeen" | "eighteen" | "nineteen" | "twenty"
       | "seven" | "eight" | "nine" | "ten" | "eleven" | "twelve" | "thirteen"

//  zone: a game zone (optionally owned)
zone: (OWNER)? (ZONE_WORD)
zones: zone ("," zone)* (","? ("and" | "and/or") zone)?
ZONE_WORD: /battlefield|graveyard|hand|library|exile/
OWNER: /target player's|that player's|each player's|target opponent's|that opponent's|an opponent's|opponent's|a player's|your|their owner's|their|the|a|its owner's/

//  player reference
player: (V_EACH | V_AN | V_TARGET | V_ANOTHER | V_THAT | "the" | "defending" | "attacking" | "active")? ("opponent" | "player" | V_YOU)

//  WHO: an actor that gains/loses life etc.
who: player | card_target | controller_subject | owner_subject
controller_subject: ("Its" | "its") "controller" | (V_THAT | "this" | "the" | "a" | "an")? ("creature" | "source" | "spell" | "permanent" | "land" | "artifact" | "enchantment" | "planeswalker" | "token" | "attacker" | "blocker" | "aura" | "object" | "ability") "'s" "controller"

//  colors
colors: color (("," | "and" | "or" | "and/or") color)*
color: COLOR
COLOR: /white|blue|black|red|green|colorless|multicolored/i

//  card types (generic + proper-noun subtypes resolved in the transformer)
types: GENERIC_TYPE | CARDNAME
GENERIC_TYPE: /creatures?|cards?|spells?|permanents?|lands?|artifacts?|enchantments?|equipment|planeswalkers?|tokens?|instants?|sorceries?|basic|nonbasic|nontoken|legendary|nonlegendary|walls?/i
INSTANT_SORCERY: /\b[iI]nstant and sorcery\b/

//  the star: an atomic card reference
card_target: lead? core? zone_mod?
//  NOTE: card_target's fields are grouped into lead/core/zone_mod (preserving the
//  exact left-to-right order) so the Earley chart doesn't combinatorially explode
//  over 13 independent optional fields.  The interpreter finds each field by name
//  anywhere in the subtree, so the grouping is transparent to it.
lead: this_that? quantifier? otherness? nontoken? | this_that? otherness? quantifier? nontoken?
core: status_list? colors? possessive? card_kind? without_mod?
without_mod: "without" KEYWORD ("or" KEYWORD)*
zone_mod: with_modifier? controller? with_modifier? in_zone? with_modifier?
            | quantifier "of" card_target
this_that: V_THIS | V_THAT | V_IT | "those" | "these" | "the"
possessive: "your" | "its" | "their" | "an opponent's" | "that player's" | "that opponent's"
otherness: V_OTHER | V_ANOTHER
nontoken: NONTYPE ("," NONTYPE)*
NONTYPE: /non(?:token|creature|land|basic|black|white|green|red|blue|multicolored)|non-[A-Z][a-zA-Z]+/i
quantifier: V_ALL | V_EACH | "every" | V_TARGET | "any number of" | "up to" amount | "that" "many" | "up to" "that" "many"
          | V_UP V_TO amount "other" V_TARGET | amount "other" V_TARGET
          | V_UP V_TO amount V_TARGET | V_UP V_TO amount | amount V_TARGET | amount | V_A | V_AN
status_list: STATUS+
STATUS: /attacking or blocking|attacking|blocking|tapped|untapped|equipped|enchanted|exiled|chosen|revealed|sacrificed|discarded|returned|created|milled|blocked|unblocked|face-up|face-down/i
card_kind: THIS_CARD types? | types
         | "activated" "or" "triggered" "ability" "s"? | "triggered" "ability" "s"? | "activated" "ability" "s"?
         | GENERIC_TYPE+ "card"?
         | "basic" THIS_CARD
         | "basic" "land" | "basic" "land" "card" | "basic" "land" "cards"
         | "source" | "sources"
         | types "or" types "card"?
         | types "," "or" types "card"?
         | types "," types "," "or" types "card"?
         | types "," types "," "and" types
         | types "and" types "card"?
         | CARDNAME ("creature" "card" | "creature" "cards" | "creature" | "creatures" | "spell" | "spells" | "card" | "cards" | "permanent" | "permanents")
         | "card" | "cards" | "creature" | "creatures" | "spell" | "spells"
         | "creature" "card" | "creature" "cards" | "land" | "land" "card" | "permanent" | "permanent" "card" | "permanent" "cards"
         | "artifact" "card" | "enchantment" "card" | "planeswalker" "card"
         | "creature" "spells" | "permanent" "spells" | "artifact" "spells" | "enchantment" "spells" | "land" "spells"
         | "creature" "spell" | "permanent" "spell" | "artifact" "spell" | "enchantment" "spell" | "land" "spell"
         | "permanents" | "token" | "tokens" | "player" | "players" | "opponent" | "opponents"
         | "it" | "them"
         | INSTANT_SORCERY "spell" "s"?
         | "instant" "or" "sorcery" "card" "s"?
         | "instant" "or" "sorcery" "spell" "s"?
         | "instant" "and" "sorcery" "card" "s"?
         | "creature" "or" "land" "card" "s"?
with_modifier: "with" (kw_list | "power" amount CMP? | "toughness" amount CMP? | "mana" "value" amount CMP? | "mana" "value" CMP "the" "number" "of" card_target | ("a")? POWER_MOD "counter" "s"? "on" ("it" | "them") | counter_name "counter" "s"? "on" ("it" | "them") | "deathtouch" | "different" "names" | "the" "same" "name" "as" "that" "permanent")
             | "that" "are" types
             | "that" "is" GENERIC_TYPE
             | "of" "the" "chosen" ("type" | "color")
             | "named" CARDNAME
             | "that" "wasn't" "put" "onto" "the" "battlefield"
             | "that" "was" "put" "there" "this" "turn"
             | "that" "was" "put" "there" "this" "instant"
             | "whose" "controller" "was" "dealt" "combat" "damage" "by" "this" "creature" "this" "turn"
             | "of" "each" "permanent" "type"
             | "revealed" "this" "way"
             | "that" "weren't" "put" "onto" "the" "battlefield"
             | "destroyed" "this" "way"
CMP: /less than or equal to|less than|or greater|or less|greater than|or equal to|at least|or less|or greater/i
controller: "you" "control" | "an" "opponent" "controls" | "your" "opponents" "control"
          | "you" "don't" "control" | "you" "own" | "you" "don't" "own" | "an" "opponent" "owns" | "its" "controller"
          | "controlled" "by" "different" "players" | "you" "already" "control"
          | "you" "cast" | "you" "played"
          | "they" "control" | "he" "controls" | "she" "controls" | "it" "controls" | "that" "player" "controls" | "target" "player" "controls"
          | "its" "owner" | "the" "player" "who" "cast" "it"
in_zone: ("in" | "from" | "on") zone | "from" "among" "them" | "of" "your" "library" | "from" "your" "graveyard"
        | "in" "a" "graveyard" | "in" "exile" | "from" "a" "graveyard" | "from" "their" "graveyard"
        | "from" "a" "single" "graveyard" | "from" "all" "graveyards" | "in" "your" "graveyard" | "on" "the" "battlefield"

//  keyword list
kw_list: kw_list_item (kw_sep kw_list_item)*
kw_list_item: KEYWORD
            | "protection" "from" prot_obj (("and" | "," | "," "and") "from" prot_obj)*
prot_obj: CARDNAME | colors | GENERIC_TYPE | "the" "color" "of" "your" "choice" | "each" "color" | "each" "player" | "anything"
kw_sep: "and" | "," | "," "and"
KEYWORD: /\b(flying|first strike|double strike|trample|deathtouch|lifelink|reach|menace|vigilance|haste|defender|hexproof|shroud|indestructible|changeling|prowess|infect|blight|wither|toxic|flashback|flash|menace|ward|deathtouch|job select|land cycling|basic landcycling|landcycling|islandwalk|swampwalk|forestwalk|mountainwalk|plainswalk)\b/i

//  modified static keywords (Ward {4}, Kicker {2}, Crew 3, ...)
MOD_KEYWORD: /ward|kicker|crew|flashback|affinity|protection|hexproof|equip/i
COND_KEYWORD: /raid|threshold|landfall|morbid|formidable|ferocious|alliance/i
static_text: any_text

//  quoted oracle text (opaque)
QUOTE: /"[^"]*"/
EMDASH: /—|–/

//  case-insensitive verb terminals (word-bounded)
//  (a verb can be sentence-initial (capitalised) or mid-sentence (lowercase))
V_ADD: /\badd\b/i
V_CREATE: /\bcreate(s?)\b/i
V_PUT: /\bput(s)?\b/i
V_REMOVE: /\bremove\b/i
V_SEARCH: /\bsearch\b/i
V_DRAW: /\bdraws?\b/i
V_ACTIVATE: /\bactivate(s?)\b/i
V_GAIN: /\bgain(s?)\b/i
V_LOSE: /\blose(s?)\b/i
V_COUNT: /\bcount(s?)\b/i
V_DEAL: /\bdeal(s?)\b/i
V_COUNTER: /\bcounter\b/i
V_RETURN: /\breturn\b/i
V_EXILE: /\bexile\b/i
V_DESTROY: /\bdestroy\b/i
V_TAP: /\btap\b/i
V_UNTAP: /\buntap\b/i
V_SACRIFICE: /\bsacrifice(s?)\b/i
V_REGENERATE: /\bregenerates?\b/i
V_SCRY: /\bscry\b/i
V_SURVEIL: /\bsurveil\b/i
V_MILL: /\bmill(s?)\b/i
V_FIGHT: /\bfight(s?)\b/i
V_SUSPECT: /\bsuspect(s?)\b/i
V_ATTACH: /\battach\b/i
V_GET: /\bget(s?)\b/i
V_HAS: /\bha[vs]e\b/i
V_PREVENT: /\bprevent\b/i
V_LOOK: /\blook(s?)\b/i
V_SEPARATE: /\bseparate(s?)\b/i
V_REVEAL: /\breveal(s?)\b/i
V_DISCARD: /\bdiscard(s?)\b/i
V_SHUFFLE: /\bshuffles?\b/i
V_CAST: /\bcast(s?)\b/i
V_PLAY: /\bplay(s?)\b/i
V_ENCHANT: /\benchant\b/i
V_ENTERS: /\benters\b/i
V_CANT: /\bcan't\b|\bdoesn't\b|\bdon't\b/i
V_CAN: /\bcan\b/i
V_TAKE: /\btake(s?)\b/i
V_PHASE: /\bphase(s|d)?\b/i
V_MAY: /\bmay\b/i
V_PAY: /\bpay(s?)\b/i
V_DOUBLE: /\bdouble\b/i
V_DISTRIBUTE: /\bdistributes?\b/i
V_CHANGE: /\bchange\b/i
V_SPEND: /\b(spend|spent)\b/i
V_COST: /\bcost(s?)\b/i
V_END: /\bend(s?)\b/i
V_WIN: /\bwin\b/i

//  case-insensitive function words (sentence-initial forms are capitalised)
V_WHEN: /\bwhen\b/i
V_WHATEVER: /\bwhenever\b/i
V_IF: /\bif\b/i
INSTEAD: /\binstead\b/i
V_IN: /\bin\b/i
V_AT: /\bat\b/i
V_AS: /\bas\b/i
V_THIS: /\bthis\b/i
V_THAT: /\bthat\b/i
V_YOU: /\byou\b/i
V_EACH: /\beach\b/i
V_OTHER: /\bother\b/i
V_EQUIPPED: /\bequipped\b/i
V_ENCHANTED: /\benchanted\b/i
V_ALL: /\ball\b/i
V_TARGET: /\btarget\b/i
V_CHOOSE: /\bchoose(s?)\b/i
V_COPY: /\bcop(?:y|ies)\b/i
V_NONTOKEN: /\bnontoken\b/i
V_INTO: /\binto\b/i
V_ONTO: /\bonto\b/i
V_ON: /\bon\b/i
V_FROM: /\bfrom\b/i
V_TO: /\bto\b/i
V_OF: /\bof\b/i
V_FOR: /\bfor\b/i
V_WITH: /\bwith\b/i
V_AND: /\band\b/i
V_OR: /\bor\b/i
V_BY: /\bby\b/i
V_IS: /\bis\b/i
V_WAS: /\bwas\b/i
V_BE: /\bbe\b/i
V_HAD: /\bhad\b/i
V_UP: /\bup\b/i
V_A: /\ba\b/i
V_AN: /\ban\b/i
V_ANOTHER: /\banother\b/i
V_IT: /\bit\b/i

//  names / words / misc
THIS_CARD: "~"
CARDNAME: /[A-Z][a-zA-Z']+(?:'s)?/
WORD: /[a-zA-Z]+(?:'s|')?/
MANA: /\{[^}]*\}/
POWER_T: /\b[0-9X]+\s*\/\s*[0-9X]+\b/i
POWER_MOD: /[+-](\d+|X)\/[+-](\d+|X)/
NUMBER: /\d+/
number: NUMBER

%ignore WS
WS: /[\s\u00A0]+/
